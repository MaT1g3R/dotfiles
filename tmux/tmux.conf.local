# ==============================================================================
# TMUX LOCAL OVERRIDES (~/.tmux.conf.local)
# Use this file for machine-specific configurations and custom overrides
# without modifying the core dotfiles repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# Custom Prefix (uncomment to override)
# ------------------------------------------------------------------------------
# unbind C-Space
# set -g prefix C-a
# bind C-a send-prefix

# ------------------------------------------------------------------------------
# Custom Status Bar Additions
# ------------------------------------------------------------------------------
# You can customize status-left or status-right here.
# For example, adding battery percentage or custom scripts:
# set -g status-right "#[fg=#343d46,bg=#1b2b34]#[fg=#a7adba,bg=#343d46] #(uptime | cut -d ',' -f 3-) #[fg=#5fb3b3,bg=#343d46]#[fg=#1b2b34,bg=#5fb3b3,bold] #h "

# ------------------------------------------------------------------------------
# Additional Plugins
# ------------------------------------------------------------------------------
# set -g @plugin 'tmux-plugins/tmux-battery'
# set -g @plugin 'tmux-plugins/tmux-cpu'

# ------------------------------------------------------------------------------
# Terminal Overrides (e.g. Alacritty, Kitty, WezTerm, Konsole, iTerm)
# ------------------------------------------------------------------------------
# set -as terminal-features ",xterm-kitty:RGB"
# set -as terminal-features ",alacritty:RGB"

# ------------------------------------------------------------------------------
# Active Pane Customization Overrides
# ------------------------------------------------------------------------------
# Ultra high-contrast yellow/gold active border instead of cyan:
# set -g pane-active-border-style "fg=#fac863,bold"
#
# Inactive pane dimming (dims foreground text in inactive panes):
# set -g window-style 'fg=#65737e'
# set -g window-active-style 'fg=#c0c5ce'

